[Unit]
Description=OpenCode server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/codeharbor
Environment=OPENCODE_SERVER_USERNAME=opencode
Environment=OPENCODE_SERVER_PASSWORD=opencode-demo-4096
ExecStart=/root/.opencode/bin/opencode serve --hostname 0.0.0.0 --port 1656
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
